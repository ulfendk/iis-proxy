# Copy to .env and fill in. .env is gitignored — never commit real
# credentials. (Deploying via Portainer from a Git repository? Set these
# same variables in the stack's "Environment variables" UI instead — see
# README.)

# Host-side interface/port docker-compose.yml publishes the proxy on.
# Set LISTEN_BIND_IP to your host's LAN IP (or your tailscale0 interface's
# IP) — leaving it at the default 0.0.0.0 exposes every interface.
LISTEN_BIND_IP=0.0.0.0
LISTEN_PORT=8080

# The real Exchange server.
UPSTREAM_SCHEME=https
UPSTREAM_HOST=mail.example.com

# Credentials injected as "Authorization: Basic base64(DOMAIN\username:password)"
# on every proxied request, replacing whatever the client (e.g. Thunderbird)
# sent. EXCHANGE_DOMAIN may be left empty if your account doesn't need a
# DOMAIN\ prefix.
EXCHANGE_DOMAIN=YOURDOMAIN
EXCHANGE_USERNAME=yourusername
EXCHANGE_PASSWORD=changeme

# Escape hatch only — leave false unless you hit unexpected TLS errors
# talking to the upstream. mail.example.com uses a standard public CA
# certificate, so this should not normally be needed.
UPSTREAM_INSECURE_SKIP_VERIFY=false

# Not read by docker-compose.yml's environment: block above (plain
# docker-compose/Portainer use case doesn't need them), but supported by
# the binary itself if you run it another way:
#
# LISTEN_ADDR=0.0.0.0:8080   # address bound inside the container's own
#                             # network namespace; LISTEN_BIND_IP/PORT above
#                             # are what actually control exposure.
# EXCHANGE_PASSWORD_FILE=/run/secrets/exchange_password   # Docker/Podman
#                             # secrets convention; takes precedence over
#                             # EXCHANGE_PASSWORD if the file exists.
